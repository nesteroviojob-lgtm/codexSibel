{
  "name": "sibel-corporate-site",
  "version": "1.0.0",
  "private": true,
  "description": "Корпоративный сайт СИБЭЛ — WordPress, точная вёрстка по Figma и управление каталогом",
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "assets": "python scripts/download-assets.py",
    "check": "node scripts/check.mjs",
    "package": "python scripts/package.py",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write wordpress scripts tests"
  },
  "devDependencies": {
    "@prettier/plugin-php": "0.26.0",
    "@wp-playground/cli": "3.1.62",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  }
}
